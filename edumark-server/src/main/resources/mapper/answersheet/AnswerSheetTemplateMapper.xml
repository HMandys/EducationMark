<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.edumark.answersheet.mapper.AnswerSheetTemplateMapper">

    <resultMap id="AnswerSheetTemplateVOMap" type="com.edumark.answersheet.vo.AnswerSheetTemplateVO">
        <id column="id" property="id"/>
        <result column="paper_id" property="paperId"/>
        <result column="paper_name" property="paperName"/>
        <result column="exam_name" property="examName"/>
        <result column="subject_name" property="subjectName"/>
        <result column="name" property="name"/>
        <result column="page_size" property="pageSize"/>
        <result column="orientation" property="orientation"/>
        <result column="columns" property="columns"/>
        <result column="margin_top" property="marginTop"/>
        <result column="margin_bottom" property="marginBottom"/>
        <result column="margin_left" property="marginLeft"/>
        <result column="margin_right" property="marginRight"/>
        <result column="header_config" property="headerConfig"
                typeHandler="com.baomidou.mybatisplus.extension.handlers.JacksonTypeHandler"/>
        <result column="student_info_config" property="studentInfoConfig"
                typeHandler="com.baomidou.mybatisplus.extension.handlers.JacksonTypeHandler"/>
        <result column="status" property="status"/>
        <result column="pdf_object_name" property="pdfObjectName"/>
        <result column="create_time" property="createTime"/>
        <result column="update_time" property="updateTime"/>
    </resultMap>

    <select id="selectPageVO" resultMap="AnswerSheetTemplateVOMap">
        SELECT t.*,
            p.name AS paper_name,
            e.name AS exam_name,
            es.subject_name
        FROM answer_sheet_template t
        LEFT JOIN paper p ON p.id = t.paper_id
        LEFT JOIN exam_subject es ON es.id = p.exam_subject_id
        LEFT JOIN exam e ON e.id = es.exam_id
        WHERE t.deleted = 0
        <if test="query.paperId != null">
            AND t.paper_id = #{query.paperId}
        </if>
        <if test="query.name != null and query.name != ''">
            AND t.name LIKE CONCAT('%', #{query.name}, '%')
        </if>
        <if test="query.status != null">
            AND t.status = #{query.status}
        </if>
        <if test="query.examId != null">
            AND e.id = #{query.examId}
        </if>
        <if test="query.subjectName != null and query.subjectName != ''">
            AND es.subject_name LIKE CONCAT('%', #{query.subjectName}, '%')
        </if>
        ORDER BY t.create_time DESC
    </select>

    <select id="selectVOById" resultMap="AnswerSheetTemplateVOMap">
        SELECT t.*,
            p.name AS paper_name,
            e.name AS exam_name,
            es.subject_name
        FROM answer_sheet_template t
        LEFT JOIN paper p ON p.id = t.paper_id
        LEFT JOIN exam_subject es ON es.id = p.exam_subject_id
        LEFT JOIN exam e ON e.id = es.exam_id
        WHERE t.id = #{id} AND t.deleted = 0
    </select>

    <select id="selectVOByPaperId" resultMap="AnswerSheetTemplateVOMap">
        SELECT t.*,
            p.name AS paper_name,
            e.name AS exam_name,
            es.subject_name
        FROM answer_sheet_template t
        LEFT JOIN paper p ON p.id = t.paper_id
        LEFT JOIN exam_subject es ON es.id = p.exam_subject_id
        LEFT JOIN exam e ON e.id = es.exam_id
        WHERE t.paper_id = #{paperId} AND t.deleted = 0
        LIMIT 1
    </select>

</mapper>
