<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.edumark.exam.mapper.PaperQuestionMapper">

    <resultMap id="PaperQuestionVOMap" type="com.edumark.exam.vo.PaperQuestionVO">
        <id column="id" property="id"/>
        <result column="paper_id" property="paperId"/>
        <result column="paper_name" property="paperName"/>
        <result column="question_no" property="questionNo"/>
        <result column="section_no" property="sectionNo"/>
        <result column="section_name" property="sectionName"/>
        <result column="item_no" property="itemNo"/>
        <result column="question_type" property="questionType"/>
        <result column="is_objective" property="isObjective"/>
        <result column="score" property="score"/>
        <result column="correct_answer" property="correctAnswer"/>
        <result column="scoring_criteria" property="scoringCriteria"/>
        <result column="double_marking_threshold" property="doubleMarkingThreshold"/>
        <result column="enable_double_marking" property="enableDoubleMarking"/>
        <result column="sort" property="sort"/>
        <result column="remark" property="remark"/>
        <result column="create_time" property="createTime"/>
    </resultMap>

    <select id="selectListByPaperId" resultMap="PaperQuestionVOMap">
        SELECT pq.*,
            p.name AS paper_name
        FROM paper_question pq
        LEFT JOIN paper p ON p.id = pq.paper_id
        WHERE pq.paper_id = #{paperId} AND pq.deleted = 0
        ORDER BY pq.sort ASC, pq.section_no ASC, pq.item_no ASC
    </select>

    <select id="selectVOById" resultMap="PaperQuestionVOMap">
        SELECT pq.*,
            p.name AS paper_name
        FROM paper_question pq
        LEFT JOIN paper p ON p.id = pq.paper_id
        WHERE pq.id = #{id} AND pq.deleted = 0
    </select>

</mapper>
