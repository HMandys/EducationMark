<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.edumark.school.mapper.ParentStudentBindMapper">

    <resultMap id="StudentBindVOMap" type="com.edumark.school.vo.ParentVO$StudentBindVO">
        <result column="bind_id" property="bindId"/>
        <result column="student_id" property="studentId"/>
        <result column="student_name" property="studentName"/>
        <result column="student_number" property="studentNumber"/>
        <result column="class_name" property="className"/>
        <result column="relation" property="relation"/>
    </resultMap>

    <select id="selectStudentsByParentId" resultMap="StudentBindVOMap">
        SELECT
            psb.id AS bind_id,
            psb.student_id,
            psb.relation,
            s.student_name AS student_name,
            s.student_code AS student_number,
            c.class_name AS class_name
        FROM parent_student_bind psb
        LEFT JOIN student s ON psb.student_id = s.id
        LEFT JOIN class_info c ON s.class_id = c.id
        WHERE psb.parent_id = #{parentId} AND s.deleted = 0
        ORDER BY psb.create_time ASC
    </select>

    <select id="selectByStudentId" resultType="com.edumark.school.entity.ParentStudentBind">
        SELECT * FROM parent_student_bind
        WHERE student_id = #{studentId}
    </select>

    <select id="selectByParentAndStudent" resultType="com.edumark.school.entity.ParentStudentBind">
        SELECT * FROM parent_student_bind
        WHERE parent_id = #{parentId} AND student_id = #{studentId}
    </select>

    <insert id="insertBind" parameterType="com.edumark.school.entity.ParentStudentBind">
        INSERT INTO parent_student_bind (
            id,
            parent_id,
            student_id,
            relation,
            create_time,
            update_time
        ) VALUES (
            #{id},
            #{parentId},
            #{studentId},
            #{relation},
            #{createTime},
            #{updateTime}
        )
    </insert>

    <delete id="deleteBindById">
        DELETE FROM parent_student_bind
        WHERE id = #{id}
    </delete>

</mapper>
